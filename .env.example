# Production Server Environment Variables

# Admin API autentifikatsiyasi uchun xavfsiz tasodifiy token
# Diqqat: Productionda kuchli, tasodifiy generatsiya qilingan kalitdan foydalaning!
# Masalan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace-with-a-long-random-secret

# Audit videolarni saqlash muddati (soatda) - default: 48
AUDIT_RETENTION_HOURS=48

# Audit videolar papkasining maksimal kvotasi (MB) - default: 500
AUDIT_MAX_STORAGE_MB=500

# Server porti - default: 3000
PORT=3000
